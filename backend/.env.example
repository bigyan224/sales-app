# Server port
PORT=4000

# MongoDB connection string (copy to .env and fill in)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/sales_tracker

# Comma separated list of allowed CORS origins, or "*" for all
CORS_ORIGIN=*

# Keep-alive cron: set to this app's public URL (e.g. https://app.onrender.com)
# to ping /api/health every KEEP_ALIVE_INTERVAL_MIN minutes so Render free
# instances don't spin down after inactivity.
KEEP_ALIVE_URL=
KEEP_ALIVE_INTERVAL_MIN=5
